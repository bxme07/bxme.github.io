function getSubjectNames(u){
  var progress=(u&&u.stats&&u.stats.subjectProgress)||{};
  var defaults=['수학','영어','국어','과학'];
  var names=[];
  var seen={};
  for(var i=0;i<defaults.length;i++){
    if(progress[defaults[i]]!==undefined || progress.hasOwnProperty(defaults[i])){
      names.push(defaults[i]);
      seen[defaults[i]]=true;
    }
  }
  for(var key in progress){
    if(progress.hasOwnProperty(key) && !seen[key]){
      names.push(key);
      seen[key]=true;
    }
  }
  if(names.length===0){ names=defaults.slice(); }
  return names;
}

function getSubjectProgressSummary(u){
  var subjects=getSubjectNames(u);
  var progress=(u&&u.stats&&u.stats.subjectProgress)||{};
  var rows=[];
  var total=0;
  for(var i=0;i<subjects.length;i++){
    var val=Number(progress[subjects[i]]||0);
    rows.push({name:subjects[i],value:val});
    total+=val;
  }
  var avg=rows.length>0?Math.round(total/rows.length):0;
  var best=rows.slice().sort(function(a,b){return b.value-a.value})[0];
  var worst=rows.slice().sort(function(a,b){return a.value-b.value})[0];
  return {rows:rows,avg:avg,best:best,worst:worst};
}

