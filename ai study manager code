      memberRank='<div style="margin-top:10px"><div style="font-size:12px;font-weight:700;margin-bottom:6px">팀원 랭킹</div>'+memberRank+'</div>';
    }
    h+='<div class="gc"><div style="margin-bottom:12px"><h3 style="font-size:14px;font-weight:700">'+g.name+'</h3><span class="bdg bdg-m" style="margin-top:6px;display:inline-block">'+g.subject+'</span></div><p style="font-size:12px;color:var(--mut);margin-bottom:8px">'+(g.desc||'함께 공부해요.')+'</p><p style="font-size:12px;color:var(--mut);margin-bottom:8px">'+(g.membersList?g.membersList.length:1)+'명 참여 · 방장 '+(g.ownerName||'관리자')+'</p>'+(memberList?'<div style="margin-bottom:8px">'+memberList+'</div>':'')+buttonHtml+memberRank+(actions?actions:'')+'</div>';
  }
  return '<h1>그룹 스터디</h1><p class="sub">그룹을 만들고, 신청을 받아 팀원을 관리하세요</p>'
    +'<div class="cd" style="margin-bottom:16px"><h3 style="font-size:14px;font-weight:700;margin-bottom:10px">새 스터디 만들기</h3><div style="display:grid;gap:8px"><input id="groupName" type="text" placeholder="스터디 이름" style="padding:10px 12px;border-radius:10px;border:1px solid var(--bdr)"><input id="groupSubject" type="text" placeholder="주제/과목" style="padding:10px 12px;border-radius:10px;border:1px solid var(--bdr)"><textarea id="groupDesc" placeholder="스터디 설명" style="padding:10px 12px;border-radius:10px;border:1px solid var(--bdr);min-height:70px;resize:vertical"></textarea><button class="btn bp" onclick="createGroup()">스터디 만들기</button></div></div>'
    +'<div class="g2">'+h+'</div>'
    +'<div class="cd" style="margin-top:16px"><h3 style="font-size:14px;font-weight:700;margin-bottom:10px">오늘 공부시간 랭킹</h3>'+rGroupRank()+'</div>';
}

function rRank(){
  var sorted=[];
  for(var i=0;i<DB.users.length;i++) sorted.push({u:DB.users[i],sh:DB.users[i].studyHours});
  sorted.sort(function(a,b){return b.sh-a.sh;});
  if(sorted.length===0) return '<h1>랭킹</h1><p class="sub">학습 시간 기반 랭킹입니다</p><div class="cd" style="text-align:center;padding:40px;color:var(--mut);font-size:13px">아직 랭킹 데이터가 없습니다.</div>';
  var icons=['','&#128081;','&#129352;','&#129353;'];
  var h='';
  for(var i=0;i<sorted.length;i++){
    var s=sorted[i],rk=i+1,me=s.u.id===cur.id;
    h+='<div class="rk'+(me?' me':'')+'"><div class="rkn">'+(icons[rk]||rk)+'</div><div class="fav" style="background:'+(me?'var(--blue)':'var(--blue-l)')+';color:'+(me?'#fff':'var(--blue)')+';width:40px;height:40px;font-size:15px">'+String((s.u.username||s.u.name||'').charAt(0)||'?')+'</div><div style="flex:1"><div style="display:flex;align-items:center;gap:6px"><span style="font-size:14px;font-weight:700">'+getDisplayName(s.u,me)+'</span>'+(me?'<span class="bdg bdg-b">나</span>':'')+'</div><div style="font-size:12px;color:var(--mut)">'+s.sh+'시간</div></div><div style="font-size:18px;font-weight:800">'+rk+'위</div></div>';
  }
  return '<h1>랭킹</h1><p class="sub">학습 시간 기반 랭킹입니다</p>'+h;
}

function getTodayStudyHours(u){
  if(!u||!u.stats||!u.stats.weeklyHours) return 0;
  var dayIndex=(new Date().getDay()+6)%7;
  return Number(u.stats.weeklyHours[dayIndex]||0);
}

function rGroupRank(){
  ensureGroupData();
  var groups=DB.groups||[];
  var h='';
  if(!groups.length){ return '<div style="font-size:13px;color:var(--mut);padding:12px 0">생성된 그룹이 없습니다.</div>'; }
  for(var i=0;i<groups.length;i++){
    var g=groups[i];
    var members=[];
    if(g.membersList && g.membersList.length){
      for(var j=0;j<g.membersList.length;j++){
        var uid=g.membersList[j];
        for(var k=0;k<DB.users.length;k++){
          if(String(DB.users[k].id)===String(uid)){
            members.push({u:DB.users[k],hours:getTodayStudyHours(DB.users[k])});
            break;
          }
        }
      }
    }
    members.sort(function(a,b){return b.hours-a.hours || String(a.u.name||'').localeCompare(String(b.u.name||''));});
    var top='';
    for(var j=0;j<Math.min(3,members.length);j++){
      var mem=members[j];
      top+='<div style="font-size:12px;color:var(--mut);margin-top:4px">• '+getDisplayName(mem.u,false)+' · '+mem.hours+'시간</div>';
    }
    h+='<div class="cd" style="margin-bottom:12px"><h3 style="font-size:14px;font-weight:700">'+g.name+'</h3><p style="font-size:12px;color:var(--mut);margin-top:4px">오늘 공부시간 기준 상위 그룹</p>'+top+'</div>';
  }
  return h;
}

function rAdmin(){
  if(!cur||cur.role!=='admin') return '<div style="padding:20px;border-radius:var(--r);background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);color:var(--red);font-size:13px;text-align:center">&#128737; 관리자 권한이 필요합니다.</div>';
  var us=DB.users;
  var h='';
  for(var i=0;i<us.length;i++){
    var u=us[i];
    h+='<tr><td><div style="display:flex;align-items:center;gap:8px"><div class="fav" style="background:var(--blue-l);color:var(--blue);width:28px;height:28px;font-size:11px">'+u.name.charAt(0)+'</div>'+u.name+'</div></td><td style="color:var(--mut)">'+u.email+'</td><td><span class="bdg bdg-b">'+(u.role==='admin'?'관리자':'일반')+'</span></td><td>'+u.studyHours+'시간</td><td style="color:var(--mut);font-size:12px">'+u.joinDate+'</td><td>'+(u.id!==cur.id?'<button class="btn bo bs" style="color:var(--red);border-color:rgba(239,68,68,.2)" onclick="delU('+u.id+')">삭제</button>':'')+'</td></tr>';
  }
  return '<h1>관리자 대시보드</h1><p class="sub">독서실 전체 관리 현황</p>'
    +'<div class="sgrid"><div class="cd sc"><div class="si" style="background:rgba(37,99,235,.1);color:var(--blue)">&#128101;</div><div><div class="sv">'+us.length+'</div><div class="sl2">전체 사용자</div></div></div>'
    +'<div class="cd sc"><div class="si" style="background:rgba(34,197,94,.1);color:var(--grn)">&#128200;</div><div><div class="sv">'+us.filter(function(u){return u.role==='user'}).length+'</div><div class="sl2">일반 사용자</div></div></div>'
    +'<div class="cd sc"><div class="si" style="background:rgba(234,179,8,.1);color:var(--yel)">&#128737;</div><div><div class="sv">'+us.filter(function(u){return u.role==='admin'}).length+'</div><div class="sl2">관리자</div></div></div>'
    +'<div class="cd sc"><div class="si" style="background:rgba(139,92,246,.1);color:var(--pur)">&#127970;</div><div><div class="sv">0</div><div class="sl2">그룹 스터디</div></div></div></div>'
    +'<div class="cd"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px"><h3 style="font-size:14px;font-weight:700">전체 사용자 관리</h3><span class="bdg bdg-m">'+us.length+'명</span></div>'
    +(us.length===0?'<p style="text-align:center;color:var(--mut);font-size:13px;padding:30px">아직 가입한 사용자가 없습니다.</p>':"<div class='tbl'><table><thead><tr><th>이름</th><th>이메일</th><th>역할</th><th>학습 시간</th><th>가입일</th><th>관리</th></tr></thead><tbody>"+h+"</tbody></table></div>")+'</div>';
}
function delU(id){var a=[];for(var i=0;i<DB.users.length;i++){if(DB.users[i].id!==id) a.push(DB.users[i]);}DB.users=a;renderPage('admin');}

function rSet(){
  var syncUrl=CLOUD_SYNC_URL||'';
  var studyLuckApiUrl=STUDY_LUCK_API_URL||'';
  var zodiacInfo=getZodiacSignFromDate(String(cur.birthDate||''));
  var zodiacText=zodiacInfo?(' · 별자리: '+zodiacInfo.name+' '+zodiacInfo.icon):'';
  var syncStateText='마지막 동기화: '+formatSyncTime(cloudLastSyncAt||cloudLastPullAt);
  var syncErrorText=cloudLastError?'<div style="font-size:12px;color:var(--red);margin-top:6px">오류: '+cloudLastError+'</div>':'';
  var expiresText=cloudExpiresAt?'<div style="font-size:12px;color:var(--mut);margin-top:4px">저장소 만료 시각: '+cloudExpiresAt+'</div>':'';
  var studyLuckErrorText=studyLuckLastError?'<div style="font-size:12px;color:var(--red);margin-top:6px">오류: '+studyLuckLastError+'</div>':'';
  return '<h1>설정</h1><p class="sub">앱 설정과 프로필을 관리하세요</p>'
    +'<div class="cd" style="display:flex;align-items:center;gap:16px;margin-bottom:16px"><div class="fav" style="background:var(--blue);color:#fff;width:56px;height:56px;font-size:20px;border-radius:16px">'+cur.name.charAt(0)+'</div><div><div style="font-size:16px;font-weight:700">'+cur.name+'</div><div style="font-size:13px;color:var(--mut)">'+cur.email+'</div><div style="font-size:12px;color:var(--mut);margin-top:2px">가입일: '+cur.joinDate+' | '+(cur.role==='admin'?'관리자':'일반 사용자')+'</div><div style="font-size:12px;color:var(--mut);margin-top:2px">아이디: '+(cur.username||'')+'</div><div style="font-size:12px;color:var(--mut);margin-top:2px">생일: '+(cur.birthDate||'미입력')+zodiacText+'</div></div></div>'
    +'<div class="cd" style="margin-bottom:16px"><h3 style="font-size:14px;font-weight:700;margin-bottom:12px">&#9729; 클라우드 동기화</h3><div style="display:grid;gap:8px"><input id="cloudUrlInput" type="text" placeholder="https://..." value="'+syncUrl+'" style="padding:10px 12px;border-radius:10px;border:1px solid var(--bdr)"><div style="font-size:12px;color:var(--mut)">다른 컴퓨터에서도 같은 URL을 입력해야 같은 계정 데이터가 누적됩니다.</div><div style="display:flex;gap:8px"><button class="btn bp" onclick="saveCloudUrlFromInput()">URL 저장 + 즉시 동기화</button><button class="btn bo" onclick="syncNow()">지금 동기화</button></div><div style="font-size:12px;color:var(--mut)">'+syncStateText+'</div>'+syncErrorText+expiresText+'</div></div>'
    +'<div class="cd" style="margin-bottom:16px"><h3 style="font-size:14px;font-weight:700;margin-bottom:12px">&#127756; 외부 공부운 API (선택)</h3><div style="display:grid;gap:8px"><input id="studyLuckApiInput" type="text" placeholder="https://.../{sign}" value="'+studyLuckApiUrl+'" style="padding:10px 12px;border-radius:10px;border:1px solid var(--bdr)"><div style="font-size:12px;color:var(--mut)">예시: https://ohmanda.com/api/horoscope/{sign} (별자리 slug: aries, taurus ...). 비워두면 앱 내 추천 문구를 사용합니다.</div><div style="display:flex;gap:8px"><button class="btn bp" onclick="saveStudyLuckApiUrlFromInput()">URL 저장</button><button class="btn bo" onclick="document.getElementById(\'studyLuckApiInput\').value=\'\';saveStudyLuckApiUrlFromInput();">연동 해제</button></div>'+studyLuckErrorText+'</div></div>'
    +'<div class="cd" style="margin-bottom:16px"><h3 style="font-size:14px;font-weight:700;margin-bottom:12px">&#127769; 화면 설정</h3>'
    +'<div class="srow"><div class="slf"><p>다크 모드</p><p>화면 테마 변경</p></div><div class="tgl" onclick="togDark();this.classList.toggle(\'on\')"></div></div></div>'
    +'<div class="cd" style="margin-bottom:16px"><h3 style="font-size:14px;font-weight:700;margin-bottom:12px">&#128100; 아이디 변경</h3><div style="display:grid;gap:8px"><input id="newUserId" type="text" placeholder="새 아이디 입력" value="'+(cur.username||'')+'" style="padding:10px 12px;border-radius:10px;border:1px solid var(--bdr)"><div style="font-size:12px;color:var(--mut)">3글자 이상의 아이디를 입력하세요.</div><button class="btn bp" onclick="changeUsername()">아이디 변경</button></div></div>'
    +'<div class="cd" style="margin-bottom:16px"><h3 style="font-size:14px;font-weight:700;margin-bottom:12px">&#127874; 생일 (선택)</h3><div style="display:grid;gap:8px"><input id="birthDateInput" type="date" value="'+(cur.birthDate||'')+'" style="padding:10px 12px;border-radius:10px;border:1px solid var(--bdr)"><div style="font-size:12px;color:var(--mut)">원하는 사용자만 입력하면 대시보드에 별자리별 공부운이 표시됩니다.</div><div style="display:flex;gap:8px"><button class="btn bp" onclick="saveBirthDate()">생일 저장</button><button class="btn bo" onclick="document.getElementById(\'birthDateInput\').value=\'\';saveBirthDate();">생일 지우기</button></div></div></div>'
    +'<div class="cd" style="margin-bottom:16px"><h3 style="font-size:14px;font-weight:700;margin-bottom:12px">&#128274; 보안</h3><div style="display:grid;gap:8px"><input id="cpw" type="password" placeholder="현재 비밀번호" style="padding:10px 12px;border-radius:10px;border:1px solid var(--bdr)"><input id="npw" type="password" placeholder="새 비밀번호" style="padding:10px 12px;border-radius:10px;border:1px solid var(--bdr)"><input id="npw2" type="password" placeholder="새 비밀번호 확인" style="padding:10px 12px;border-radius:10px;border:1px solid var(--bdr)"><button class="btn bp" onclick="changePassword()">비밀번호 변경</button></div></div>'
    +'<div class="cd" style="border-color:rgba(239,68,68,.2)"><h3 style="font-size:14px;font-weight:700;margin-bottom:12px;color:var(--red)">&#9211; 계정</h3><button class="btn bo" style="width:100%;text-align:left;padding:12px" onclick="doLogout()">로그아웃</button></div>';
}

go('pg-land');
</script>
