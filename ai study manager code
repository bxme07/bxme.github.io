function getLuckDateKey(){
  var now=new Date();
  return now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0')+'-'+String(now.getDate()).padStart(2,'0');
}

function buildStudyLuckApiUrl(sign){
  var base=String(STUDY_LUCK_API_URL||'').trim();
  if(!base) return '';
  var slug=String((sign&&sign.slug)||'').trim().toLowerCase();
  if(base.indexOf('{sign}')>-1){
    return base.replace('{sign}', encodeURIComponent(slug||String((sign&&sign.name)||'')));
  }
  var sep=base.indexOf('?')>-1?'&':'?';
  if(base.endsWith('/')) return base+encodeURIComponent(slug||String((sign&&sign.name)||''));
  return base+sep+'sign='+encodeURIComponent(slug||String((sign&&sign.name)||''));
}

function parseStudyLuckApiMessage(data){
  if(!data) return '';
  if(typeof data==='string') return data;
  var msg='';
  msg=data.horoscope||data.description||data.message||data.fortune||data.text||'';
  if(!msg && data.data){
    var d=data.data;
    msg=d.horoscope||d.description||d.message||d.fortune||d.text||'';
  }
  return String(msg||'');
}

function getCachedExternalZodiacStudyLuck(u){
  if(!u || !u.birthDate) return null;
  var sign=getZodiacSignFromDate(String(u.birthDate||''));
  if(!sign) return null;
  var key=String(sign.slug||sign.name)+'|'+getLuckDateKey();
  var cached=studyLuckCache[key];
  if(!cached) return null;
  return {signName:sign.name,signIcon:sign.icon,message:cached,source:'api'};
}

async function requestExternalZodiacStudyLuck(u){
  if(!u || !u.birthDate) return;
  var sign=getZodiacSignFromDate(String(u.birthDate||''));
  if(!sign) return;
  var url=buildStudyLuckApiUrl(sign);
  if(!url) return;
  var key=String(sign.slug||sign.name)+'|'+getLuckDateKey();
  if(studyLuckCache[key] || studyLuckInFlight[key]) return;
  var failedAt=Number(studyLuckFailedKeys[key]||0);
  if(failedAt && Date.now()-failedAt < 30*60*1000) return;
  studyLuckInFlight[key]=true;
  try{
    var res=await fetch(url,{method:'GET',cache:'no-store'});
    if(!res.ok) throw new Error('운세 API 응답 코드 '+res.status);
    var data=null;
    try{ data=await res.json(); }
    catch(e){ data=await res.text(); }
    var msg=parseStudyLuckApiMessage(data).replace(/\s+/g,' ').trim();
    if(!msg) throw new Error('운세 API 응답에서 문구를 찾지 못했습니다.');
    if(msg.length>240) msg=msg.slice(0,240)+'...';
    studyLuckCache[key]=msg;
    studyLuckLastError='';
    delete studyLuckFailedKeys[key];
    if(cNav==='dashboard' && cur && String(cur.id)===String(u.id)) renderPage('dashboard');
  }catch(e){
    studyLuckLastError=String((e&&e.message)||e||'외부 운세를 불러오지 못했습니다.');
    studyLuckFailedKeys[key]=Date.now();
  }finally{
    delete studyLuckInFlight[key];
  }
}

function saveStudyLuckApiUrlFromInput(){
  var input=document.getElementById('studyLuckApiInput');
  if(!input) return;
  var next=String(input.value||'').trim();
  if(!next){
    localStorage.removeItem('studyLuckApiUrl');
    STUDY_LUCK_API_URL='';
    studyLuckCache={};
    studyLuckInFlight={};
    studyLuckFailedKeys={};
    studyLuckLastError='';
    alert('외부 공부운 API 연동을 해제했습니다.');
    renderPage('settings');
    return;
  }
  localStorage.setItem('studyLuckApiUrl', next);
  STUDY_LUCK_API_URL=next;
  studyLuckCache={};
  studyLuckInFlight={};
  studyLuckFailedKeys={};
  studyLuckLastError='';
  if(cur){ requestExternalZodiacStudyLuck(cur); }
  alert('외부 공부운 API URL이 저장되었습니다.');
