  var goalInput=document.getElementById('weeklyGoalHours');
  var oldToday=Number(cur.stats.todayHours||0);
  var newToday=Number(todayInput?todayInput.value:0)||0;
  var weeklyGoalHours=Number(goalInput?goalInput.value:15)||15;
  var dayIndex=(new Date().getDay()+6)%7;
  weekly[dayIndex]=newToday;
  cur.stats.weeklyHours=weekly;
  cur.stats.subjectProgress=subjectProgress;
  cur.stats.weeklyGoalHours=weeklyGoalHours;
  cur.stats.todayHours=newToday;
  cur.studyHours=Math.max(0, Number(cur.studyHours||0)+newToday-oldToday);
  cur.stats.prevWeeklyHours=cur.stats.prevWeeklyHours===undefined?null:cur.stats.prevWeeklyHours;
  updateAppleTreeFromProgress(cur, subjectProgress);
  ensureUserData(cur);
  saveAppState();
  loadAppState();
  ensureUserData(cur);
  renderPage('stats');
  alert('저장되었습니다.');
}

function hasPrevWeeklyData(prevWeekly){
