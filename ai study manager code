function maskName(name, isMe){
  if(isMe || !name) return name || '';
  var n=String(name||'');
  if(n.length<=1) return n;
  return n.charAt(0)+'**';
}

function getDisplayName(u, isMe){
  if(!u) return '';
  var idText=String(u.username||u.id||'').trim();
  if(idText) return isMe ? idText : maskName(idText, false);
  return isMe ? String(u.name||'') : maskName(String(u.name||''), false);
}

