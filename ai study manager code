function startAutoCloudSync(){
  if(cloudAutoSyncTimer) return;
  cloudAutoSyncTimer=setInterval(function(){
    if(!CLOUD_SYNC_URL) return;
    pullFromCloud();
  },30000);
}

async function pullFromCloud(){
  if(!CLOUD_SYNC_URL) return;
  if(cloudSyncInFlight) return;
  cloudSyncInFlight=true;
  cloudLastError='';
  try{
    var res=await fetch(CLOUD_SYNC_URL,{method:'GET',cache:'no-store'});
    if(!res.ok){
      cloudLastError='GET 실패 ('+res.status+')';
      return;
    }
    cloudExpiresAt=res.headers.get('x-jsonblob-expires-at')||cloudExpiresAt;
    var remoteRaw=await res.json();
    var remote=normalizeRemoteState(remoteRaw);
    var local={users:DB.users||[],groups:DB.groups||[],updatedAt:Number(DB.updatedAt||0)};
    var mergedUsers=mergeUsers(local.users,remote.users);
    var mergedGroups=(remote.groups&&remote.groups.length)?remote.groups:local.groups;
    var mergedUpdatedAt=Math.max(Number(local.updatedAt||0),Number(remote.updatedAt||0),Date.now());
    applyMergedState({users:mergedUsers,groups:mergedGroups,updatedAt:mergedUpdatedAt});
    cloudLastPullAt=Date.now();
    cloudLastSyncAt=cloudLastPullAt;
  }catch(e){ cloudLastError=(e&&e.message)?e.message:'GET 요청 오류'; }
  finally{ cloudSyncInFlight=false; }
}

async function pushToCloud(){
  if(!CLOUD_SYNC_URL) return;
  if(cloudSyncInFlight){ cloudSyncQueued=true; return; }
  cloudSyncInFlight=true;
  cloudLastError='';
  try{
    var payload={users:DB.users||[],groups:DB.groups||[],updatedAt:Number(DB.updatedAt||Date.now())};
    var res=await fetch(CLOUD_SYNC_URL,{
      method:'PUT',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify(payload)
    });
    if(!res.ok){
      cloudLastError='PUT 실패 ('+res.status+')';
    }
    else{
      cloudExpiresAt=res.headers.get('x-jsonblob-expires-at')||cloudExpiresAt;
      cloudLastSyncAt=Date.now();
    }
  }catch(e){ cloudLastError=(e&&e.message)?e.message:'PUT 요청 오류'; }
  finally{
    cloudSyncInFlight=false;
    if(cloudSyncQueued){
      cloudSyncQueued=false;
      pushToCloud();
    }
  }
}

function queueCloudPush(){
  if(!CLOUD_SYNC_URL) return;
  pushToCloud();
}

