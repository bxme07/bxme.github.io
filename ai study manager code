function saveAppState(){
  try{
    if(!DB.groups || !Array.isArray(DB.groups)) ensureGroupData();
    if(cur){
      cur.updatedAt=Date.now();
      var exists=false;
      for(var i=0;i<DB.users.length;i++){
        if(String(DB.users[i].id)===String(cur.id)){
          DB.users[i]=cur;
          exists=true;
          break;
        }
      }
      if(!exists){ DB.users.push(cur); }
      localStorage.setItem('studyAppCurrentUserId', String(cur.id));
    }
    else{ localStorage.removeItem('studyAppCurrentUserId'); }
    DB.updatedAt=Date.now();
    localStorage.setItem('studyAppUsers', JSON.stringify(DB.users||[]));
    localStorage.setItem('studyAppGroups', JSON.stringify(DB.groups||[]));
    localStorage.setItem('studyAppUpdatedAt', String(DB.updatedAt||0));
  }catch(e){}
  queueCloudPush();
}

function userKey(u){
  var email=String((u&&u.email)||'').trim().toLowerCase();
  var username=String((u&&u.username)||'').trim().toLowerCase();
  if(email) return 'email:'+email;
  if(username) return 'username:'+username;
  return 'id:'+String((u&&u.id)||'');
}

function pickNewerUser(a,b){
  var aTs=Number((a&&a.updatedAt)||0);
  var bTs=Number((b&&b.updatedAt)||0);
  return bTs>=aTs ? b : a;
}

function mergeUsers(localUsers, remoteUsers){
  var byKey={};
  var i;
  for(i=0;i<(localUsers||[]).length;i++){
    byKey[userKey(localUsers[i])]=localUsers[i];
  }
  for(i=0;i<(remoteUsers||[]).length;i++){
    var key=userKey(remoteUsers[i]);
    if(!byKey[key]) byKey[key]=remoteUsers[i];
    else byKey[key]=pickNewerUser(byKey[key], remoteUsers[i]);
  }
  var merged=[];
  for(var k in byKey){
    if(Object.prototype.hasOwnProperty.call(byKey,k)) merged.push(byKey[k]);
  }
  return merged;
}

function applyMergedState(merged){
  DB.users=merged.users||[];
  if(Array.isArray(merged.groups)) DB.groups=merged.groups;
  DB.updatedAt=Number(merged.updatedAt||Date.now());
  var savedId=localStorage.getItem('studyAppCurrentUserId');
  if(cur){
    var ck=userKey(cur);
    for(var i=0;i<DB.users.length;i++){
      if(userKey(DB.users[i])===ck){ cur=DB.users[i]; break; }
    }
  } else if(savedId){
    for(var j=0;j<DB.users.length;j++){
      if(String(DB.users[j].id)===String(savedId)){ cur=DB.users[j]; break; }
    }
  }
  try{
    localStorage.setItem('studyAppUsers', JSON.stringify(DB.users||[]));
    localStorage.setItem('studyAppGroups', JSON.stringify(DB.groups||[]));
    localStorage.setItem('studyAppUpdatedAt', String(DB.updatedAt||0));
    if(cur) localStorage.setItem('studyAppCurrentUserId', String(cur.id));
  }catch(e){}
}

function normalizeRemoteState(raw){
  var users=Array.isArray(raw&&raw.users) ? raw.users : [];
  var groups=Array.isArray(raw&&raw.groups) ? raw.groups : [];
  var updatedAt=Number((raw&&raw.updatedAt)||0);
  return {users:users,groups:groups,updatedAt:updatedAt};
}

function formatSyncTime(ts){
  if(!ts) return '아직 동기화 기록 없음';
  var d=new Date(ts);
  if(isNaN(d.getTime())) return '동기화 시간 확인 불가';
  var y=d.getFullYear();
  var m=String(d.getMonth()+1).padStart(2,'0');
  var day=String(d.getDate()).padStart(2,'0');
  var hh=String(d.getHours()).padStart(2,'0');
  var mm=String(d.getMinutes()).padStart(2,'0');
  var ss=String(d.getSeconds()).padStart(2,'0');
  return y+'-'+m+'-'+day+' '+hh+':'+mm+':'+ss;
}

