function updateAppleTreeFromProgress(u, subjectProgress){
  if(!u) return {pointsEarned:0,qualifiedCount:0};
  ensureUserData(u);
  var tree=u.appleTree||{};
  var count=0;
  for(var key in subjectProgress){
    if(Object.prototype.hasOwnProperty.call(subjectProgress,key) && Number(subjectProgress[key]||0) >= 90){
      count++;
    }
  }
  var prevCount=Number(tree.lastQualifiedCount||0);
  var delta=count-prevCount;
  if(delta>0){
    var earned=delta*10;
    tree.points=Number(tree.points||0)+earned;
    tree.apples=Math.floor(Number(tree.points||0)/10);
    tree.stage=Math.min(5, Math.floor(tree.points/50));
    tree.lastQualifiedCount=count;
  }
  else if(prevCount===0 && count===0){
    tree.lastQualifiedCount=0;
  }
  if(Number(tree.points||0) > 250){
    tree.completedTrees=Number(tree.completedTrees||0)+1;
    tree.points=0;
    tree.stage=0;
    tree.apples=0;
    tree.lastQualifiedCount=0;
  }
  return {pointsEarned:delta>0?delta*10:0,qualifiedCount:count,completedTrees:Number(tree.completedTrees||0)};
}

