function renderSurvey(){
  var q=sQs[sStep];
  document.getElementById('sqc').textContent=(sStep+1)+' / '+sQs.length;
  var pct=Math.round(((sStep+1)/sQs.length)*100);
  document.getElementById('spct').textContent=pct+'%';
  document.getElementById('sbar').style.width=pct+'%';
  document.getElementById('sqq').textContent=q.q;
  var h='';
  if(q.type==='multi'){
    var ans=sAns[sStep]||{selected:[],text:''};
    for(var i=0;i<q.o.length;i++){
      var checked=ans.selected.indexOf(i)!==-1;
      h+='<label class="opt'+(checked?' sel':'')+'" style="display:flex;align-items:center;gap:10px"><input type="checkbox" '+(checked?'checked':'')+' onchange="toggleMultiS('+i+')" style="transform:scale(1.08)"><span>'+q.o[i]+'</span></label>';
    }
    h+='<textarea id="surveyText" oninput="updateSurveyText(this.value)" placeholder="추가로 하고 싶은 쉬는 시간 활동이나 메모를 적어주세요" style="width:100%;margin-top:8px;padding:10px 12px;border-radius:10px;border:1px solid var(--bdr);min-height:84px;resize:vertical">'+(ans.text||'')+'</textarea>';
  }
  else{
    for(var i=0;i<q.o.length;i++){
      h+='<div class="opt'+(sAns[sStep]===i?' sel':'')+'" onclick="pickS('+i+')">'+q.o[i]+'</div>';
    }
  }
  document.getElementById('sqopts').innerHTML=h;
  document.getElementById('sprev').disabled=sStep===0;
  var nb2=document.getElementById('snext');
  if(sStep===sQs.length-1){nb2.textContent='완료 ✓';nb2.onclick=function(){enterDash();};}
  else{nb2.innerHTML='다음 &#8594;';nb2.onclick=function(){sNav(1);};}
  var ready=false;
  if(q.type==='multi'){
    var curAns=sAns[sStep]||{selected:[],text:''};
    ready=(curAns.selected.length>0 || (curAns.text||'').trim().length>0);
  }
  else{ready=sAns[sStep]!==undefined;}
  nb2.disabled=!ready;
}
function pickS(i){sAns[sStep]=i;renderSurvey();}
function updateSurveyText(value){
  var ans=sAns[sStep]||{selected:[],text:''};
  ans.text=value||'';
  sAns[sStep]=ans;
}
function toggleMultiS(i){
  var ans=sAns[sStep]||{selected:[],text:''};
  var selected=ans.selected||[];
  var idx=selected.indexOf(i);
  if(idx===-1){selected.push(i);} else {selected.splice(idx,1);} 
  ans.selected=selected;
  sAns[sStep]=ans;
  renderSurvey();
}
function sNav(d){sStep=Math.max(0,Math.min(sQs.length-1,sStep+d));renderSurvey();}
function restartSurvey(){
  sStep=0;
  sAns={};
  if(cur){
    cur.surveyAnswers={};
    saveAppState();
  }
  go('pg-survey');
  renderSurvey();
}
window.restartSurvey=restartSurvey;

